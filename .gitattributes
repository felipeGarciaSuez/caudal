# Normalizar todo el texto a LF en el repo (Git detecta binarios y no los toca).
# Evita el ruido de CRLF cuando se edita en Windows/WSL, y que un .sh o el
# entrypoint lleguen al contenedor Linux con CRLF.
* text=auto eol=lf

# Explicitos por si acaso (scripts y archivos que corren dentro del contenedor).
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
