# Plantilla del .env de PRODUCCIÓN (VPS). El archivo real vive solo en el
# servidor, en /opt/apps/caudal/.env, y nunca se versiona.
#
# Generar la SECRET_KEY con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=
DEBUG=False

# Host canónico. www redirige al apex desde Caddy, así que no hace falta acá.
ALLOWED_HOSTS=caudalwallet.com
CSRF_TRUSTED_ORIGINS=https://caudalwallet.com

# --- Postgres (en el VPS, red interna de Docker) -----------------------------
POSTGRES_DB=caudal
POSTGRES_USER=caudal
POSTGRES_PASSWORD=

# El host es `db`, el nombre del servicio en docker-compose.prod.yml.
DATABASE_URL=postgres://caudal:LA_MISMA_PASSWORD@db:5432/caudal

# IMPRESCINDIBLE. config/settings/prod.py pone sslmode=require por defecto
# porque asumía Neon. Contra el Postgres de la red interna de Docker eso
# falla al conectar: no hay TLS ahí, y no hace falta, el tráfico no sale
# del host.
DB_SSLMODE=disable

# --- App ---------------------------------------------------------------------
TIME_ZONE=America/Argentina/Cordoba
LANGUAGE_CODE=es-ar

# Sacar el admin de /admin/, que es lo primero que prueban los bots.
# Mantener la barra final.
ADMIN_URL=

# django-axes: 1 proxy adelante (Caddy). Si algún día se mete Cloudflare,
# esto pasa a 2 — ver docs/decisiones.md en el repo infra.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
AXES_PROXY_COUNT=1

# --- Primer superusuario -----------------------------------------------------
# El entrypoint corre ensure_superuser, que es idempotente. Se pueden borrar
# estas líneas después del primer arranque.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
